# Скопіюйте цей файл у .env і заповніть значення: cp .env.example .env
# Формат: KEY=VALUE, один параметр на рядок. Лапки навколо значення необов'язкові.
# Коментарі лише на окремих рядках (символ # всередині значення вважається частиною значення).

# Пароль користувача admin на всіх пристроях (обов'язково).
# Можна згенеровувати випадковий разом з Wi-Fi: python3 randomize.py --admin-password
ADMIN_PASSWORD=change-me

# Пароль Wi-Fi, WPA2/WPA3-PSK, від 8 до 63 символів (обов'язково).
# Можна згенерувати випадковий: python3 randomize.py
WIFI_PASSWORD=change-me-too

# Назва мережі (SSID) для 2.4 ГГц. Для 5 ГГц до неї додається суфікс -5g (обов'язково, до 29 символів).
# randomize.py замінює останні 4 символи на випадкові шістнадцяткові (0-9, A-F), як у назвах TP-Link (Tp-Link_0000 -> Tp-Link_7D15)
WIFI_SSID=Tp-Link_0000

# Країна для регуляторних обмежень Wi-Fi (за замовчуванням Ukraine)
WIFI_COUNTRY=Ukraine

# Кількість точок доступу кожного типу: для них генеруються файли ac3-1.rsc, ac3-2.rsc, ax3-1.rsc, ...
# Кожна точка отримує унікальне ім'я (identity) в межах мережі (за замовчуванням 2 і 2)
AC3_COUNT=2
AX3_COUNT=2
